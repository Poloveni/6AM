# ==========================================================
#  6AM — Configuration
#  Copier ce fichier en .env puis remplir les valeurs.
#      cp .env.example .env
#  Ne JAMAIS committer le .env (il est dans .gitignore).
# ==========================================================

# ---------- Application ----------
NODE_ENV=production
PORT=3000
# URL publique complete du site (sert aux liens absolus et aux cookies)
APP_URL=https://6am.example.com
# Mettre a 1 si l'app est derriere un reverse proxy (nginx, traefik...)
TRUST_PROXY=1

# ---------- Identite du site ----------
SITE_NAME=6AM
SITE_TAGLINE=Serveur GTA RP
SITE_DESCRIPTION=Le serveur roleplay 6AM — une ville, des histoires, une communaute.
SITE_LOCALE=fr-FR

# ---------- Liens communaute ----------
DISCORD_INVITE=https://discord.gg/xxxxxxx
FIVEM_CONNECT=fivem://connect/xxxxxx
TWITTER_URL=
YOUTUBE_URL=
TIKTOK_URL=

# ---------- Base de donnees ----------
# Client supporte : "pg" (PostgreSQL) ou "mysql2" (MariaDB / MySQL)
DB_CLIENT=pg
DB_HOST=db
DB_PORT=5432
DB_NAME=sixam
DB_USER=sixam
DB_PASSWORD=change-me-database-password
# Alternative : URL de connexion complete (prioritaire sur les variables ci-dessus)
# DATABASE_URL=postgres://sixam:password@db:5432/sixam
# DATABASE_URL=mysql://sixam:password@db:3306/sixam
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------- Session / securite ----------
# Generer avec : openssl rand -hex 32
SESSION_SECRET=change-me-avec-openssl-rand-hex-32
SESSION_NAME=sixam.sid
# Duree de session en heures
SESSION_TTL_HOURS=168
# Cookies secure : 1 en HTTPS, 0 en local http
COOKIE_SECURE=1

# ---------- Compte administrateur initial (seed) ----------
ADMIN_EMAIL=admin@6am.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ---------- Integrations optionnelles ----------
# Webhook Discord pour les logs RH (embauches, promotions, licenciements)
DISCORD_WEBHOOK_URL=
# Nom affiche par le webhook
DISCORD_WEBHOOK_USERNAME=6AM RH

# ---------- Docker compose ----------
# Utilise uniquement par docker-compose pour initialiser le conteneur DB
POSTGRES_DB=sixam
POSTGRES_USER=sixam
POSTGRES_PASSWORD=change-me-database-password
MARIADB_DATABASE=sixam
MARIADB_USER=sixam
MARIADB_PASSWORD=change-me-database-password
MARIADB_ROOT_PASSWORD=change-me-root-password
# Port expose sur l'hote par nginx
HTTP_PORT=80
HTTPS_PORT=443
# Domaine servi par nginx
DOMAIN=6am.example.com
# Adresse utilisee pour le certificat Let's Encrypt
LETSENCRYPT_EMAIL=admin@6am.example.com
