# ==========================================================
#  6AM — Configuration
#  Copier ce fichier en .env puis remplir les valeurs.
#      cp .env.example .env
#  Ne JAMAIS committer le .env (il est dans .gitignore).
# ==========================================================

# ---------- Application ----------
NODE_ENV=production
# Port ecoute PAR l'application a l'interieur du conteneur (ne pas changer)
PORT=3000
# URL publique complete du site (sert aux liens absolus et aux cookies)
APP_URL=https://6am.example.com
# Mettre a 1 si l'app est derriere un reverse proxy (nginx, traefik...)
TRUST_PROXY=1

# ---------- Identite du site ----------
SITE_NAME=6AM
SITE_TAGLINE=Los Santos · 6AM
SITE_DESCRIPTION=6AM — pendant qu'ils dorment, nous preparons demain. Groupe roleplay de Los Santos.
SITE_LOCALE=fr-FR

# ---------- Liens communaute ----------
DISCORD_INVITE=https://discord.gg/xxxxxxx
FIVEM_CONNECT=fivem://connect/xxxxxx
TWITTER_URL=
YOUTUBE_URL=
TIKTOK_URL=

# ---------- Base de donnees ----------
# Client supporte : "pg" (PostgreSQL) ou "mysql2" (MariaDB / MySQL)
DB_CLIENT=pg
# Nom unique de la base du site. Ne PAS mettre "db" : cet alias est courant,
# et si le conteneur web rejoint un reseau exterieur (docker-compose.bot.yml)
# le DNS de Docker peut renvoyer la base d'un autre projet.
DB_HOST=sixam-db
DB_PORT=5432
DB_NAME=sixam
DB_USER=sixam
DB_PASSWORD=change-me-database-password
# Alternative : URL de connexion complete (prioritaire sur les variables ci-dessus)
# DATABASE_URL=postgres://sixam:password@db:5432/sixam
# DATABASE_URL=mysql://sixam:password@db:3306/sixam
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------- Session / securite ----------
# Generer avec : openssl rand -hex 32
SESSION_SECRET=change-me-avec-openssl-rand-hex-32
SESSION_NAME=sixam.sid
# Duree de session en heures
SESSION_TTL_HOURS=168
# Cookies secure : 1 en HTTPS, 0 en local http
COOKIE_SECURE=1

# ---------- Compte administrateur initial (seed) ----------
ADMIN_EMAIL=admin@6am.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ---------- Pont vers le bot Discord (optionnel, LECTURE SEULE) ----------
# Base PostgreSQL du bot "roxwood-network-famille". Laisser vide tant que le
# bot n'est pas installe : les pages afficheront simplement "bot non connecte".
# Utiliser un utilisateur SANS DROIT D'ECRITURE (voir README) : le bot doit
# rester le seul a modifier ses donnees.
BOT_DATABASE_URL=
BOT_DB_SSL=false

# ---------- Integrations optionnelles ----------
# Webhook Discord pour les logs RH (embauches, promotions, licenciements)
DISCORD_WEBHOOK_URL=
# Nom affiche par le webhook
DISCORD_WEBHOOK_USERNAME=6AM RH

# ---------- Docker compose ----------
# Prefixe des conteneurs, volumes et reseaux de ce projet.
# Indispensable quand plusieurs projets cohabitent sur la meme machine.
COMPOSE_PROJECT_NAME=sixam

# VPS partage derriere un Caddy existant : decommenter pour que la
# surcouche soit appliquee sans avoir a repeter les -f a chaque commande.
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml

# Port ouvert SUR LE SERVEUR pour joindre l'application.
# Choisir un port libre, different de celui des autres projets.
APP_PORT=3000
# 127.0.0.1 = accessible uniquement depuis le serveur (cas d'un reverse proxy deja en place)
# 0.0.0.0   = accessible depuis l'exterieur sur http://IP:APP_PORT (test sans domaine)
APP_BIND=127.0.0.1

# Utilise uniquement par docker-compose pour initialiser le conteneur DB
POSTGRES_DB=sixam
POSTGRES_USER=sixam
POSTGRES_PASSWORD=change-me-database-password
MARIADB_DATABASE=sixam
MARIADB_USER=sixam
MARIADB_PASSWORD=change-me-database-password
MARIADB_ROOT_PASSWORD=change-me-root-password
# Port expose sur l'hote par nginx
HTTP_PORT=80
HTTPS_PORT=443
# Domaine servi par nginx
DOMAIN=6am.example.com
# Adresse utilisee pour le certificat Let's Encrypt
LETSENCRYPT_EMAIL=admin@6am.example.com

# ---------- Site en pause ----------
# on    : pause forcee, quoi que dise la base
# off   : site force ouvert (porte de sortie si la base repond mal)
# vide  : c'est le reglage "Mettre le site en pause" de l'administration qui decide
MAINTENANCE=
