# ==========================================================
#  6AM — bloc a AJOUTER EN TETE du Caddyfile partage du VPS
#         (/opt/dynasty8/deploy/vps/Caddyfile)
#
#  IMPORTANT : ces deux blocs doivent se trouver AVANT le bloc
#  attrape-tout ":80". Celui-ci capte toutes les requetes HTTP
#  sans distinction d'hote ; s'il passe en premier, 6AM ne sera
#  jamais atteint.
#
#  Caddy obtient et renouvelle le certificat automatiquement :
#  ni certbot, ni port supplementaire a ouvrir.
#
#  Rechargement apres modification :
#    docker exec vps-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#    docker exec vps-caddy-1 caddy reload   --config /etc/caddy/Caddyfile
# ==========================================================

# --- 6AM : redirection HTTP -> HTTPS ---
# Necessaire explicitement : l'attrape-tout ":80" empeche Caddy
# d'installer sa redirection automatique.
http://6amfbfa.duckdns.org {
	redir https://{host}{uri} permanent
}

# --- 6AM : site en HTTPS ---
6amfbfa.duckdns.org {
	encode zstd gzip

	reverse_proxy sixam-app:3000 {
		header_up X-Real-IP {remote_host}
	}
}

