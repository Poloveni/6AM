# ==========================================================
#  Caddyfile partage du VPS 51.255.173.188
#
#  Un bloc par site, cible par NOM DE CONTENEUR (sans ambiguite,
#  contrairement aux alias de service qui peuvent se recouvrir).
#
#  L'attrape-tout ":80" capte toutes les requetes HTTP sans
#  distinction d'hote : il doit IMPERATIVEMENT rester en dernier,
#  et chaque site nomme a besoin de son propre bloc "http://"
#  pour la redirection vers HTTPS, que l'attrape-tout empeche
#  Caddy d'installer automatiquement.
#
#  Rechargement :
#    docker exec vps-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#    docker exec vps-caddy-1 caddy reload   --config /etc/caddy/Caddyfile
# ==========================================================

# ---------- MAJA 13 ----------
http://lamaja13.duckdns.org {
	redir https://{host}{uri} permanent
}

lamaja13.duckdns.org {
	encode gzip
	reverse_proxy maja13-app-1:3000
}

# ---------- 6AM ----------
http://6amfbfa.duckdns.org {
	redir https://{host}{uri} permanent
}

6amfbfa.duckdns.org {
	encode zstd gzip

	reverse_proxy sixam-web-1:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# ---------- Dynasty 8 ----------
# Attrape-tout HTTP sur l'adresse IP. Le domaine dynasty8.fbfa.fr est
# heberge chez l'operateur FlashbackFA, pas ici.
# NE RIEN AJOUTER APRES CE BLOC.
:80 {
	reverse_proxy app:3000
	encode gzip
}
