# Rendu par nginx au demarrage : ${DOMAIN} est remplace par la variable d'env.
upstream sixam_app {
    server web:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Challenge Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Tant qu'aucun certificat n'existe, on sert l'app en clair.
    # Une fois le certificat obtenu, decommenter la redirection ci-dessous
    # et le bloc server 443, puis : docker compose restart nginx
    # location / { return 301 https://$host$request_uri; }

    location / {
        proxy_pass http://sixam_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

