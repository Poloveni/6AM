{
  "name": "6am-web",
  "version": "1.0.0",
  "private": true,
  "description": "Site public + espace membres du serveur RP 6AM",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "seed": "knex --knexfile knexfile.js seed:run",
    "setup": "npm run migrate && npm run seed",
    "pause": "node scripts/pause.js on",
    "reprise": "node scripts/pause.js off",
    "pause:etat": "node scripts/pause.js etat"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-session-knex": "^4.0.2",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "pg": "^8.12.0"
  }
}
