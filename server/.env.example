# ---- 6AM / le QG ----
# Modèle de configuration. Sur le serveur, le script vps-setup.sh crée le vrai
# fichier server/.env tout seul en te posant les questions.
# Ne publie JAMAIS le fichier .env (il est exclu de Git par .gitignore).

PORT=3000
# Adresse publique du site, sans « / » à la fin — sert aussi au retour de Discord
BASE_URL=https://6am.example.com
# Clé des sessions : générer avec   openssl rand -hex 32
SESSION_SECRET=

# Base de données (en Docker, seul POSTGRES_PASSWORD suffit)
POSTGRES_PASSWORD=
# Hors Docker uniquement :
# DATABASE_URL=postgres://sixam:motdepasse@127.0.0.1:5432/sixam

# Application Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID du serveur Discord de 6AM : seuls ses membres peuvent se connecter
DISCORD_GUILD_ID=
# Optionnel : chemin de retour enregistré dans Discord (défaut /auth/discord/callback)
DISCORD_REDIRECT_PATH=
# Optionnel : rôle Discord -> grade du site, format  idRole:grade,idRole:grade
# grades possibles : voir server/src/ranks.js (lead, co-lead, devweb, bras-droit, lieutenant, dealer, recrue)
DISCORD_ROLE_MAP=
# IDs Discord validés d'office (grade Dev Web) au premier login, séparés par des virgules
ADMIN_DISCORD_IDS=

# Optionnel : bot Discord roxwood-network-famille, affiché en LECTURE SEULE
# dans le QG (Gestion → Le Bot). Rempli automatiquement par deploy/bot-link.sh.
# BOT_DATABASE_URL=postgresql://sixam_ro:motdepasse@conteneur-base-du-bot:5432/base
# BOT_GUILD_ID=        (défaut : DISCORD_GUILD_ID)
