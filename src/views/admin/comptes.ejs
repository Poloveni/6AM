<div class="wrap">
  <div class="app-shell">
    <%- include('../partials/sidenav') %>
    <div>
      <%- include('../partials/flash') %>
      <div class="page-head"><h1>Comptes</h1></div>

      <div class="card" style="margin-bottom:22px">
        <h3>Creer un compte</h3>
        <form method="post" action="/espace/administration/comptes">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <div class="field">
              <label for="username">Identifiant</label>
              <input id="username" name="username" type="text" required>
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required>
            </div>
            <div class="field">
              <label for="password">Mot de passe</label>
              <input id="password" name="password" type="password" minlength="10" required autocomplete="new-password">
            </div>
            <div class="field">
              <label for="role">Role</label>
              <select id="role" name="role">
                <option value="member">Membre</option>
                <option value="staff">Staff</option>
                <option value="admin">Administrateur</option>
              </select>
            </div>
            <div class="field">
              <label for="member_id">Fiche effectif</label>
              <select id="member_id" name="member_id">
                <option value="">Aucune</option>
                <% members.forEach(function (m) { %>
                  <option value="<%= m.id %>"><%= m.rp_name %></option>
                <% }); %>
              </select>
            </div>
          </div>
          <button class="btn btn-primary" type="submit">Creer le compte</button>
        </form>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Identifiant</th><th>Email</th><th>Fiche</th><th>Role</th><th>Actif</th><th>Derniere connexion</th><th></th></tr>
          </thead>
          <tbody>
            <% users.forEach(function (u) { %>
              <tr>
                <td><%= u.username %></td>
                <td class="muted"><%= u.email %></td>
                <td>
                  <select name="member_id" form="user-<%= u.id %>" style="min-width:150px">
                    <option value="">Aucune</option>
                    <% members.forEach(function (m) { %>
                      <option value="<%= m.id %>" <%= u.rp_name === m.rp_name ? 'selected' : '' %>><%= m.rp_name %></option>
                    <% }); %>
                  </select>
                </td>
                <td>
                  <select name="role" form="user-<%= u.id %>" <%= u.id === user.id ? 'disabled' : '' %> style="min-width:120px">
                    <option value="member" <%= u.role === 'member' ? 'selected' : '' %>>Membre</option>
                    <option value="staff"  <%= u.role === 'staff'  ? 'selected' : '' %>>Staff</option>
                    <option value="admin"  <%= u.role === 'admin'  ? 'selected' : '' %>>Admin</option>
                  </select>
                </td>
                <td>
                  <label class="check"><input type="checkbox" name="is_active" form="user-<%= u.id %>" <%= u.is_active ? 'checked' : '' %> <%= u.id === user.id ? 'disabled' : '' %>></label>
                </td>
                <td class="muted"><%= h.formatDateTime(u.last_login_at, site.locale) %></td>
                <td class="num" style="white-space:nowrap">
                  <input type="password" name="password" form="user-<%= u.id %>" placeholder="Nouveau mdp" style="width:130px;display:inline-block" autocomplete="new-password">
                  <button class="btn btn-sm" type="submit" form="user-<%= u.id %>">OK</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% users.forEach(function (u) { %>
        <form id="user-<%= u.id %>" method="post" action="/espace/administration/comptes/<%= u.id %>" hidden>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        </form>
      <% }); %>

      <p class="help">Un administrateur ne peut modifier ni son propre role ni son propre statut actif.</p>
    </div>
  </div>
</div>
