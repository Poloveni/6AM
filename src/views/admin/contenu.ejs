<div class="wrap">
  <div class="app-shell">
    <%- include('../partials/sidenav') %>
    <div>
      <%- include('../partials/flash') %>
      <div class="page-head"><h1>Contenu du site</h1></div>

      <div class="card">
        <form method="post" action="/espace/administration/contenu">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="field">
            <label for="maintenance" style="display:flex;align-items:center;gap:10px;cursor:pointer">
              <input id="maintenance" name="maintenance" type="checkbox" value="on"
                     style="width:auto;margin:0" <%= values.maintenance === 'on' ? 'checked' : '' %>>
              Mettre le site en pause
            </label>
            <p class="help" style="margin-top:8px">
              Coupe la totalite du site, espace membres compris : les visiteurs voient une page
              d'attente. <strong>Une fois active, cette page ne sera plus accessible.</strong>
              Pour rouvrir, lancer sur le serveur&nbsp;:
              <code>docker compose exec web npm run reprise</code>
            </p>
          </div>
          <div class="field">
            <label for="maintenance_message">Message affiche pendant la pause</label>
            <input id="maintenance_message" name="maintenance_message" type="text" maxlength="400"
                   placeholder="Laisser vide pour le texte par defaut"
                   value="<%= values.maintenance_message || '' %>">
          </div>

          <hr style="border:0;border-top:1px solid var(--line);margin:26px 0">

          <div class="field">
            <label for="home_headline">Titre de l'accueil</label>
            <input id="home_headline" name="home_headline" type="text" value="<%= values.home_headline || '' %>">
          </div>
          <div class="field">
            <label for="home_subline">Sous-titre de l'accueil</label>
            <input id="home_subline" name="home_subline" type="text" value="<%= values.home_subline || '' %>">
          </div>
          <div class="field">
            <label for="about_text">Presentation du serveur</label>
            <textarea id="about_text" name="about_text"><%= values.about_text || '' %></textarea>
          </div>
          <div class="field">
            <label for="rules_text">Reglement</label>
            <textarea id="rules_text" name="rules_text" style="min-height:260px"><%= values.rules_text || '' %></textarea>
          </div>
          <button class="btn btn-primary" type="submit">Enregistrer</button>
        </form>
      </div>
      <p class="help">Le nom du serveur, les liens Discord/FiveM et les couleurs se configurent dans le fichier <code>.env</code>.</p>
    </div>
  </div>
</div>
