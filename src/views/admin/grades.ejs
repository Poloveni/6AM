<div class="wrap">
  <div class="app-shell">
    <%- include('../partials/sidenav') %>
    <div>
      <%- include('../partials/flash') %>
      <div class="page-head"><h1>Grades</h1></div>

      <div class="card" style="margin-bottom:22px">
        <h3>Nouveau grade</h3>
        <form method="post" action="/espace/administration/grades">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <div class="field">
              <label for="name">Nom</label>
              <input id="name" name="name" type="text" required>
            </div>
            <div class="field">
              <label for="level">Niveau</label>
              <input id="level" name="level" type="number" value="10" min="0" max="1000">
              <p class="help">Plus le niveau est haut, plus le grade est eleve.</p>
            </div>
            <div class="field">
              <label for="color">Couleur</label>
              <input id="color" name="color" type="color" value="#4a6a8f">
            </div>
            <div class="field">
              <label>&nbsp;</label>
              <label class="check"><input type="checkbox" name="is_staff"> Grade staff</label>
            </div>
          </div>
          <div class="field">
            <label for="description">Description</label>
            <input id="description" name="description" type="text">
          </div>
          <button class="btn btn-primary" type="submit">Creer</button>
        </form>
      </div>

      <div class="grid grid-2">
        <% ranks.forEach(function (r) { %>
          <div class="card">
            <form method="post" action="/espace/administration/grades/<%= r.id %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-row">
                <div class="field">
                  <label>Nom</label>
                  <input name="name" type="text" value="<%= r.name %>">
                </div>
                <div class="field">
                  <label>Niveau</label>
                  <input name="level" type="number" value="<%= r.level %>">
                </div>
                <div class="field">
                  <label>Couleur</label>
                  <input name="color" type="color" value="<%= r.color %>">
                </div>
              </div>
              <div class="field">
                <label>Description</label>
                <input name="description" type="text" value="<%= r.description || '' %>">
              </div>
              <label class="check"><input type="checkbox" name="is_staff" <%= r.is_staff ? 'checked' : '' %>> Grade staff</label>
              <div class="form-actions">
                <button class="btn btn-sm btn-primary" type="submit">Enregistrer</button>
                <button class="btn btn-sm btn-ghost" type="submit" name="_action" value="delete" data-confirm="Supprimer ce grade ?">Supprimer</button>
              </div>
            </form>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>
