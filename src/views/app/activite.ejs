<div class="wrap">
  <div class="app-shell">
    <%- include('../partials/sidenav') %>
    <div>
      <%- include('../partials/flash') %>
      <div class="page-head">
        <h1>Activite</h1>
        <span class="spacer"></span>
        <% if (isStaff) { %>
          <form method="get" class="toolbar" style="margin:0">
            <select name="membre" data-auto-submit>
              <option value="">Tous les membres</option>
              <% members.forEach(function (m) { %>
                <option value="<%= m.id %>" <%= filterMember === m.id ? 'selected' : '' %>><%= m.rp_name %></option>
              <% }); %>
            </select>
          </form>
        <% } %>
      </div>

      <div class="card" style="margin-bottom:22px">
        <h3>Nouvelle saisie</h3>
        <form method="post" action="/espace/activite">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-row">
            <% if (isStaff) { %>
              <div class="field">
                <label for="member_id">Membre</label>
                <select id="member_id" name="member_id">
                  <% members.forEach(function (m) { %>
                    <option value="<%= m.id %>" <%= user.member_id === m.id ? 'selected' : '' %>><%= m.rp_name %></option>
                  <% }); %>
                </select>
              </div>
            <% } %>
            <div class="field">
              <label for="occurred_on">Date</label>
              <input id="occurred_on" name="occurred_on" type="date" value="<%= today %>" required>
            </div>
            <div class="field">
              <label for="hours">Heures de service</label>
              <input id="hours" name="hours" type="text" inputmode="decimal" placeholder="2.5" value="0">
            </div>
            <div class="field">
              <label for="actions">Actions</label>
              <input id="actions" name="actions" type="number" min="0" value="0">
            </div>
            <div class="field">
              <label for="amount">Chiffre ($)</label>
              <input id="amount" name="amount" type="number" min="0" value="0">
            </div>
          </div>
          <div class="field">
            <label for="note">Note</label>
            <input id="note" name="note" type="text" placeholder="Patrouille, intervention, evenement...">
          </div>
          <button class="btn btn-primary" type="submit">Enregistrer</button>
        </form>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <% if (isStaff) { %><th>Membre</th><% } %>
              <th class="num">Service</th>
              <th class="num">Actions</th>
              <th class="num">Chiffre</th>
              <th>Note</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (!entries.length) { %>
              <tr><td colspan="7" class="muted center">Aucune activite enregistree.</td></tr>
            <% } %>
            <% entries.forEach(function (e) { %>
              <tr>
                <td><%= h.formatDate(e.occurred_on, site.locale) %></td>
                <% if (isStaff) { %><td><%= e.rp_name || '—' %></td><% } %>
                <td class="num"><%= h.formatDuration(e.minutes) %></td>
                <td class="num"><%= e.actions %></td>
                <td class="num"><%= h.formatMoney(e.amount) %></td>
                <td class="muted"><%= e.note || '' %></td>
                <td class="num">
                  <form method="post" action="/espace/activite/<%= e.id %>/supprimer" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-ghost" type="submit" data-confirm="Supprimer ?">Supprimer</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
