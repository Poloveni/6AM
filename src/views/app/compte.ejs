<div class="wrap">
  <div class="app-shell">
    <%- include('../partials/sidenav') %>
    <div>
      <div class="page-head">
        <div>
          <p class="eyebrow">Espace membres</p>
          <h1>Mon compte</h1>
        </div>
      </div>

      <div class="grid grid-2">
        <div class="card">
          <h3>Informations</h3>
          <div class="bar-row"><span class="muted">Identifiant</span><span class="bar-track"></span><span class="num"><%= user.username %></span></div>
          <% if (user.discord_username) { %>
            <div class="bar-row"><span class="muted">Discord</span><span class="bar-track"></span><span class="num"><%= user.discord_username %></span></div>
          <% } %>
          <% if (user.email) { %>
            <div class="bar-row"><span class="muted">Email</span><span class="bar-track"></span><span class="num"><%= user.email %></span></div>
          <% } %>
          <div class="bar-row"><span class="muted">Rôle</span><span class="bar-track"></span><span class="num"><%= h.ROLES[user.role] || user.role %></span></div>
          <div class="bar-row"><span class="muted">Fiche RP</span><span class="bar-track"></span><span class="num"><%= user.rp_name || '—' %></span></div>
          <div class="bar-row"><span class="muted">Grade</span><span class="bar-track"></span><span class="num"><%= user.rank_name || '—' %></span></div>

          <% if (!user.member_id) { %>
            <p class="help" style="margin-top:20px">
              Aucune fiche d’effectif n’est reliée à ce compte : c’est pourquoi « Ma semaine »
              et le classement ne t’affichent pas. Un administrateur peut faire le lien depuis
              Administration&nbsp;→&nbsp;Comptes, ou renseigner ton identifiant Discord sur ta fiche.
            </p>
          <% } %>
        </div>

        <div class="card">
          <h3>Connexion</h3>
          <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
          <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

          <% if (compte.discord_id) { %>
            <div class="bar-row"><span class="muted">Méthode</span><span class="bar-track"></span><span class="num">Discord</span></div>
            <% if (compte.discord_linked_at) { %>
              <div class="bar-row"><span class="muted">Relié le</span><span class="bar-track"></span><span class="num"><%= h.formatDate(compte.discord_linked_at, site.locale) %></span></div>
            <% } %>
          <% } %>

          <% if (!compte.aMotDePasse && !compte.peutDefinir) { %>
            <%# Membre connecte par Discord : rien a gerer ici. %>
            <p class="help" style="margin-top:18px">
              Tu te connectes avec Discord : ce compte n’a pas de mot de passe, il n’y a donc
              rien à changer. Pour te déconnecter, utilise le lien en bas de page.
            </p>
            <% if (links.discord) { %>
              <a class="btn btn-sm btn-ghost" style="margin-top:16px" href="<%= links.discord %>" target="_blank" rel="noopener">Ouvrir le Discord</a>
            <% } %>

          <% } else { %>
            <p class="help" style="margin-top:18px">
              <% if (compte.aMotDePasse) { %>
                Mot de passe de secours, utilisable sur <code>/connexion/secours</code> si Discord
                est indisponible.
              <% } else { %>
                Ce compte n’a pas encore de mot de passe de secours. En définir un te permet
                d’entrer par <code>/connexion/secours</code> si Discord tombe — utile pour un
                administrateur.
              <% } %>
            </p>

            <form method="post" action="/espace/mon-compte" style="margin-top:20px">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (compte.aMotDePasse) { %>
                <div class="field">
                  <label for="current_password">Mot de passe actuel</label>
                  <input id="current_password" name="current_password" type="password" required autocomplete="current-password">
                </div>
              <% } %>
              <div class="field">
                <label for="new_password"><%= compte.aMotDePasse ? 'Nouveau mot de passe' : 'Mot de passe de secours' %></label>
                <input id="new_password" name="new_password" type="password" required minlength="10" autocomplete="new-password">
                <p class="help">10 caractères minimum.</p>
              </div>
              <div class="field">
                <label for="confirm_password">Confirmation</label>
                <input id="confirm_password" name="confirm_password" type="password" required autocomplete="new-password">
              </div>
              <button class="btn btn-primary" type="submit"><%= compte.aMotDePasse ? 'Mettre à jour' : 'Définir le mot de passe' %></button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
