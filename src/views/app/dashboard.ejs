<div class="wrap">
  <div class="app-shell">
    <%- include('../partials/sidenav') %>
    <div>
      <%- include('../partials/flash') %>
      <div class="page-head">
        <div>
          <p class="eyebrow">Bonjour <%= user.rp_name || user.username %></p>
          <h1>Tableau de bord</h1>
        </div>
        <span class="spacer"></span>
        <a class="btn btn-sm btn-primary" href="/espace/activite">Saisir une activité</a>
      </div>

      <div class="grid grid-4" style="margin-bottom:26px">
        <div class="card stat">
          <div class="stat-value"><%= kpi.active %></div>
          <div class="stat-label">En service</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= kpi.onLeave %></div>
          <div class="stat-label">En congé</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= Math.round(kpi.minutes / 60) %> h</div>
          <div class="stat-label">Service · 30 j</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= h.formatMoney(kpi.amount) %></div>
          <div class="stat-label">Chiffre · 30 j</div>
        </div>
      </div>

      <div class="grid grid-2">
        <div class="card">
          <h3>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            Mon activité · 30 jours
          </h3>
          <% if (mine) { %>
            <div class="metrics">
              <div class="metric">
                <span class="metric__icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 1.8"/></svg></span>
                <span class="metric__label">Temps de service</span>
                <span class="metric__value"><%= h.formatDuration(mine.minutes) %></span>
              </div>
              <div class="metric">
                <span class="metric__icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 18V9M10 18V5M16 18v-6M22 18h-20"/></svg></span>
                <span class="metric__label">Actions</span>
                <span class="metric__value"><%= mine.actions %></span>
              </div>
              <div class="metric">
                <span class="metric__icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v18M16 7.5c0-1.7-1.8-2.5-4-2.5s-4 .8-4 2.5S9.8 10 12 10s4 .9 4 2.6-1.8 2.6-4 2.6-4-.9-4-2.6"/></svg></span>
                <span class="metric__label">Chiffre</span>
                <span class="metric__value"><%= h.formatMoney(mine.amount) %></span>
              </div>
            </div>
            <a class="btn btn-sm btn-ghost" href="/espace/activite" style="margin-top:16px">Voir le détail</a>
            <div class="spark" aria-hidden="true">
              <svg viewBox="0 0 320 62" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="sparkFill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#7fb0e2" stop-opacity=".34"/>
                    <stop offset="100%" stop-color="#5f98d6" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M0 48 L40 42 L80 46 L120 33 L160 38 L200 24 L240 30 L280 17 L320 22 L320 62 L0 62 Z" fill="url(#sparkFill)"/>
                <path d="M0 48 L40 42 L80 46 L120 33 L160 38 L200 24 L240 30 L280 17 L320 22" fill="none" stroke="rgba(168,210,251,.75)" stroke-width="1.6"/>
              </svg>
            </div>
          <% } else { %>
            <div class="vide">
              <span class="vide__rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M16 19a4 4 0 0 0-8 0"/><circle cx="12" cy="10" r="3.2"/><circle cx="12" cy="12" r="9"/></svg></span>
              <p>Aucune fiche d’effectif n’est liée à ton compte.</p>
              <small>Un administrateur peut faire le lien depuis ta fiche.</small>
              <span class="vide__trait"></span>
            </div>
          <% } %>
        </div>

        <div class="card">
          <h3>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v18"/><circle cx="12" cy="8" r="2.2"/><circle cx="12" cy="16" r="2.2"/></svg>
            Derniers mouvements
          </h3>
          <% if (!events.length) { %>
            <div class="vide">
              <span class="vide__rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 6h14M5 12h9M5 18h5"/></svg></span>
              <p>Aucun mouvement enregistré.</p>
              <small>Embauches, promotions et départs apparaîtront ici.</small>
              <span class="vide__trait"></span>
            </div>
          <% } else { %>
            <ul class="timeline" style="margin-top:14px">
              <% events.forEach(function (e) { %>
                <li>
                  <div class="t-head">
                    <span class="t-type"><%= h.EVENT_LABELS[e.type] || e.type %></span>
                    <span class="t-date"><%= h.formatDateTime(e.created_at, site.locale) %></span>
                  </div>
                  <div class="t-body"><%= e.rp_name || 'Fiche supprimee' %><%= e.reason ? ' — ' + e.reason : '' %></div>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>

      </div>
      <div class="grid grid-2" style="margin-top:22px">
        <div class="card">
          <h3>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
            Répartition des effectifs
          </h3>
          <% if (!repartition.length) { %>
            <div class="vide">
              <span class="vide__rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="3.4"/><path d="M5 20a7 7 0 0 1 14 0"/></svg></span>
              <p>Aucun membre en service.</p>
              <span class="vide__trait"></span>
            </div>
          <% } else { %>
            <% var maxGrade = Math.max.apply(null, repartition.map(function (r) { return r.total; })); %>
            <div class="metrics">
              <% repartition.forEach(function (r) { %>
                <div class="rang">
                  <span class="rang__nom"><i class="rang__pastille" style="background:<%= r.couleur %>"></i><%= r.nom %></span>
                  <span class="rang__piste"><span class="rang__jauge" style="width:<%= Math.round((r.total / maxGrade) * 100) %>%;background:linear-gradient(90deg,<%= r.couleur %>55,<%= r.couleur %>)"></span></span>
                  <span class="rang__val"><%= r.total %></span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="card">
          <h3>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 21h8M12 17v4M6 4h12v5a6 6 0 0 1-12 0V4ZM18 5h2.5a2.5 2.5 0 0 1 0 5H18M6 5H3.5a2.5 2.5 0 0 0 0 5H6"/></svg>
            Les plus actifs · 30 jours
          </h3>
          <% if (!top.length) { %>
            <div class="vide">
              <span class="vide__rond"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 17l5-6 4 3 5-7 4 4"/></svg></span>
              <p>Aucune activité saisie sur la période.</p>
              <small>Les saisies apparaîtront ici, classées par temps de service.</small>
              <span class="vide__trait"></span>
            </div>
          <% } else { %>
            <div class="metrics">
              <% top.forEach(function (m, i) { %>
                <div class="podium">
                  <span class="podium__place"><%= i + 1 %></span>
                  <a class="podium__nom" href="/espace/effectifs/<%= m.id %>"><%= m.nom %></a>
                  <span class="podium__detail"><%= m.actions %> action<%= m.actions > 1 ? 's' : '' %> · <%= h.formatMoney(m.amount, site.locale) %></span>
                  <span class="podium__val"><%= h.formatDuration(m.minutes) %></span>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>
