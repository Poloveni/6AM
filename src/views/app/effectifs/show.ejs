<% var isStaff = h.roleAtLeast(user.role, 'staff'); %>
<div class="wrap">
  <div class="app-shell">
    <%- include('../../partials/sidenav') %>
    <div>
      <%- include('../../partials/flash') %>

      <div class="page-head">
        <div>
          <p class="eyebrow">Fiche effectif</p>
          <h1><%= member.rp_name %></h1>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <% if (member.rank_name) { %>
              <span class="badge" style="color:<%= member.rank_color %>"><span class="dot"></span><%= member.rank_name %></span>
            <% } %>
            <span class="badge badge-<%= member.status %>"><span class="dot"></span><%= h.STATUS_LABELS[member.status] %></span>
          </div>
        </div>
        <span class="spacer"></span>
        <% if (isStaff) { %>
          <a class="btn btn-sm" href="/espace/effectifs/<%= member.id %>/modifier">Modifier</a>
        <% } %>
        <a class="btn btn-sm btn-ghost" href="/espace/effectifs">Retour</a>
      </div>

      <div class="grid grid-2" style="margin-bottom:22px">
        <div class="card">
          <h3>Informations</h3>
          <div class="bar-row"><span class="muted">Discord</span><span></span><span class="num"><%= member.discord_tag || '—' %></span></div>
          <div class="bar-row"><span class="muted">ID Discord</span><span></span><span class="num"><%= member.discord_id || '—' %></span></div>
          <div class="bar-row"><span class="muted">Telephone</span><span></span><span class="num"><%= member.phone || '—' %></span></div>
          <div class="bar-row"><span class="muted">Arrivee</span><span></span><span class="num"><%= h.formatDate(member.hired_at, site.locale) %></span></div>
          <% if (member.left_at) { %>
            <div class="bar-row"><span class="muted">Depart</span><span></span><span class="num"><%= h.formatDate(member.left_at, site.locale) %></span></div>
          <% } %>
          <% if (member.notes) { %>
            <p class="muted" style="margin-top:14px;white-space:pre-line"><%= member.notes %></p>
          <% } %>
        </div>

        <div class="card">
          <h3>Activite · 30 jours</h3>
          <div class="bar-row"><span class="muted">Temps de service</span><span></span><span class="num"><%= h.formatDuration(totals.minutes) %></span></div>
          <div class="bar-row"><span class="muted">Actions</span><span></span><span class="num"><%= totals.actions %></span></div>
          <div class="bar-row"><span class="muted">Chiffre</span><span></span><span class="num"><%= h.formatMoney(totals.amount) %></span></div>
          <a class="btn btn-sm btn-ghost" style="margin-top:10px" href="/espace/activite?membre=<%= member.id %>">Voir les saisies</a>
        </div>
      </div>

      <% if (isStaff) { %>
        <div class="grid grid-2" style="margin-bottom:22px">
          <div class="card">
            <h3>Grade</h3>
            <form method="post" action="/espace/effectifs/<%= member.id %>/grade">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field">
                <label for="rank_id">Nouveau grade</label>
                <select id="rank_id" name="rank_id">
                  <option value="">Sans grade</option>
                  <% ranks.forEach(function (r) { %>
                    <option value="<%= r.id %>" <%= member.rank_id === r.id ? 'selected' : '' %>><%= r.name %></option>
                  <% }); %>
                </select>
              </div>
              <div class="field">
                <label for="grade_reason">Motif</label>
                <input id="grade_reason" name="reason" type="text" placeholder="Merite, anciennete...">
              </div>
              <button class="btn btn-primary btn-sm" type="submit">Appliquer</button>
            </form>
          </div>

          <div class="card">
            <h3>Statut</h3>
            <form method="post" action="/espace/effectifs/<%= member.id %>/statut">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field">
                <label for="status">Nouveau statut</label>
                <select id="status" name="status">
                  <option value="active" <%= member.status === 'active' ? 'selected' : '' %>>En service</option>
                  <option value="leave" <%= member.status === 'leave' ? 'selected' : '' %>>En conge</option>
                  <option value="fired" <%= member.status === 'fired' ? 'selected' : '' %>>Licencie</option>
                  <option value="resigned" <%= member.status === 'resigned' ? 'selected' : '' %>>Demission</option>
                </select>
              </div>
              <div class="field">
                <label for="status_reason">Motif</label>
                <input id="status_reason" name="reason" type="text">
              </div>
              <button class="btn btn-primary btn-sm" type="submit">Appliquer</button>
            </form>
          </div>
        </div>

        <div class="card" style="margin-bottom:22px">
          <h3>Ajouter au dossier</h3>
          <form method="post" action="/espace/effectifs/<%= member.id %>/note">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-row">
              <div class="field">
                <label for="note_type">Type</label>
                <select id="note_type" name="type">
                  <option value="note">Note</option>
                  <option value="warned">Avertissement</option>
                </select>
              </div>
              <div class="field" style="grid-column:span 2">
                <label for="note_reason">Contenu</label>
                <input id="note_reason" name="reason" type="text" required>
              </div>
            </div>
            <button class="btn btn-sm" type="submit">Ajouter</button>
          </form>
        </div>
      <% } %>

      <div class="card">
        <h3>Historique</h3>
        <% if (!events.length) { %>
          <p class="muted" style="margin:0">Aucun evenement.</p>
        <% } else { %>
          <ul class="timeline" style="margin-top:14px">
            <% events.forEach(function (e) { %>
              <li>
                <div class="t-head">
                  <span class="t-type"><%= EVENT_LABELS[e.type] || e.type %></span>
                  <span class="t-date"><%= h.formatDateTime(e.created_at, site.locale) %></span>
                  <% if (e.actor_name) { %><span class="t-date">par <%= e.actor_name %></span><% } %>
                </div>
                <div class="t-body">
                  <% if (e.from_rank_id || e.to_rank_id) { %>
                    <%= ranksById[e.from_rank_id] || 'sans grade' %> → <%= ranksById[e.to_rank_id] || 'sans grade' %><%= e.reason ? ' · ' : '' %>
                  <% } %><%= e.reason || '' %>
                </div>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>

      <% if (user.role === 'admin') { %>
        <form method="post" action="/espace/effectifs/<%= member.id %>/supprimer" style="margin-top:18px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-sm btn-ghost" type="submit" data-confirm="Supprimer definitivement ?">Supprimer la fiche</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
