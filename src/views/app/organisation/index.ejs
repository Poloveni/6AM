<div class="wrap">
  <div class="app-shell">
    <%- include('../../partials/sidenav') %>
    <div>
      <div class="page-head">
        <div>
          <p class="eyebrow">Données du bot Discord · lecture seule</p>
          <h1>Organisation</h1>
        </div>
        <span class="spacer"></span>
        <% if (tier) { %>
          <span class="chip"><%= h.TIERS[tier] || tier %></span>
        <% } %>
        <% if (semaine && semaine.debut) { %>
          <span class="chip">Semaine depuis le <%= h.formatDateTime(semaine.debut, site.locale) %></span>
        <% } %>
      </div>

      <%- include('../../partials/bot-absent') %>

      <div class="grid grid-4" style="margin-bottom:26px">
        <div class="card stat">
          <div class="stat-value"><%= totaux.membres %></div>
          <div class="stat-label">Ont déclaré</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= sansDeclaration.length %></div>
          <div class="stat-label">Sans déclaration</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= h.formatMoney(Math.round(totaux.salaire), site.locale) %></div>
          <div class="stat-label">Paie de la semaine</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= coffre.length %></div>
          <div class="stat-label">Lignes de coffre</div>
        </div>
      </div>

      <div class="card" style="margin-bottom:22px">
        <h3>Classement de la semaine</h3>
        <% if (!classement.length) { %>
          <p class="muted" style="margin:0">Aucune activité déclarée depuis la dernière remise à zéro.</p>
        <% } else { %>
          <div class="table-wrap" style="border:0">
            <table>
              <thead>
                <tr>
                  <th>Membre</th>
                  <% Object.keys(h.CATEGORIES_BOT).forEach(function (cat) { %>
                    <th class="num"><%= h.CATEGORIES_BOT[cat] %><% if (objectifs[cat]) { %> <span class="muted">/<%= objectifs[cat] %></span><% } %></th>
                  <% }); %>
                  <th class="num">Paie</th>
                </tr>
              </thead>
              <tbody>
                <% classement.forEach(function (m) { %>
                  <tr>
                    <td>
                      <% if (m.memberId) { %><a href="/espace/effectifs/<%= m.memberId %>"><%= m.nom %></a><% } else { %><span class="muted"><%= m.nom %></span><% } %>
                      <% if (m.grade) { %><br><span class="badge" style="color:<%= m.couleur %>;font-size:.66rem"><span class="dot"></span><%= m.grade %></span><% } %>
                    </td>
                    <% Object.keys(h.CATEGORIES_BOT).forEach(function (cat) { %>
                      <% var v = m.parCategorie[cat] || 0; var atteint = objectifs[cat] && v >= objectifs[cat]; %>
                      <td class="num" style="<%= atteint ? 'color:var(--good)' : '' %>"><%= v %></td>
                    <% }); %>
                    <td class="num"><%= h.formatMoney(Math.round(m.salaire), site.locale) %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <% if (braquages.length) { %>
        <div class="card" style="margin-bottom:22px">
          <h3>Braquages · 7 derniers jours</h3>
          <p class="help" style="margin-top:0">
            Plafonds du type d’organisation « <%= h.TIERS[tier] || tier %> ».
            Fenêtre glissante tenue par le bot, indépendante de la remise à zéro des quotas.
          </p>
          <div class="grid grid-3" style="gap:14px">
            <% braquages.forEach(function (b) { %>
              <div class="card stat" style="<%= !b.accessible ? 'opacity:.45' : '' %>">
                <div class="stat-value" style="<%= b.atteint ? 'color:var(--warn)' : '' %>">
                  <%= b.fait %><span class="muted" style="font-size:.5em">/<%= b.plafond %></span>
                </div>
                <div class="stat-label"><%= b.label %></div>
                <% if (!b.accessible) { %><div class="help" style="margin:6px 0 0">Non accessible</div><% } %>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <% if (coffres.length > 1) { %>
        <div class="card" style="margin-bottom:22px">
          <h3>Répartition par coffre</h3>
          <p class="help" style="margin-top:0">Détail par salon de log suivi — le total ci-dessus les additionne.</p>
          <div class="table-wrap" style="border:0">
            <table>
              <thead><tr><th>Coffre</th><th>Contenu</th><th class="num">Total</th></tr></thead>
              <tbody>
                <% coffres.forEach(function (c) { %>
                  <tr>
                    <td class="muted">#<%= c.salon.slice(-6) %></td>
                    <td>
                      <% if (!c.groupes.length) { %><span class="muted">vide</span><% } %>
                      <% c.groupes.slice(0, 6).forEach(function (g, i) { %><%= i ? ' · ' : '' %><%= g.nom %> <span class="muted"><%= g.total %></span><% }); %>
                      <% if (c.groupes.length > 6) { %><span class="muted"> · +<%= c.groupes.length - 6 %></span><% } %>
                    </td>
                    <td class="num"><%= c.total.toLocaleString('fr-FR') %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <div class="grid grid-2">
        <div class="card">
          <h3>Coffre</h3>
          <% if (!coffre.length) { %><p class="muted" style="margin:0">Aucun stock suivi.</p><% } %>
          <% var maxCoffre = Math.max(1, ...coffre.map(function (g) { return g.total; })); %>
          <% coffre.forEach(function (g) { %>
            <div class="bar-row">
              <span><%= g.nom %><% if (g.production) { %> <span class="muted" style="font-size:.72em">production</span><% } %></span>
              <span class="bar-track"><span class="bar-fill" style="width:<%= Math.round((g.total / maxCoffre) * 100) %>%"></span></span>
              <span class="num"><%= g.total.toLocaleString('fr-FR') %></span>
            </div>
          <% }); %>
        </div>

        <div class="card">
          <h3>Derniers mouvements</h3>
          <% if (!mouvements.length) { %><p class="muted" style="margin:0">Aucun mouvement enregistré.</p><% } %>
          <ul class="timeline" style="margin-top:14px">
            <% mouvements.forEach(function (m) { %>
              <li>
                <div class="t-head">
                  <span class="t-type"><%= m.action %> <%= m.item %></span>
                  <span class="t-date"><%= h.formatDateTime(m.timestamp, site.locale) %></span>
                </div>
                <div class="t-body"><%= m.joueur %> — <%= m.quantite > 0 ? '+' : '' %><%= m.quantite %> (<%= m.stock_avant %> → <%= m.stock_apres %>)</div>
              </li>
            <% }); %>
          </ul>
        </div>
      </div>

      <% if (sansDeclaration.length) { %>
        <div class="card" style="margin-top:22px">
          <h3>Rien déclaré cette semaine</h3>
          <p class="help" style="margin-top:0">Membres en service dont l’identifiant Discord est relié, sans aucune activité depuis la remise à zéro.</p>
          <div class="chips">
            <% sansDeclaration.forEach(function (m) { %>
              <a class="chip" href="/espace/effectifs/<%= m.id %>"><%= m.rp_name %></a>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
