<%
  var maxMin = Math.max(1, ...series.map(function (d) { return d.minutes; }));
  var maxRank = Math.max(1, ...ranking.map(function (r) { return r.minutes; }));
  var maxDist = Math.max(1, ...distribution.map(function (d) { return d.count; }));
%>
<div class="wrap">
  <div class="app-shell">
    <%- include('../partials/sidenav') %>
    <div>
      <div class="page-head">
        <h1>Statistiques</h1>
        <span class="spacer"></span>
        <div class="chips">
          <% Object.keys(ranges).forEach(function (key) { %>
            <a class="chip <%= String(days) === key ? 'is-active' : '' %>" href="/espace/statistiques?periode=<%= key %>"><%= ranges[key] %></a>
          <% }); %>
        </div>
      </div>

      <div class="grid grid-4" style="margin-bottom:26px">
        <div class="card stat">
          <div class="stat-value"><%= Math.round(totals.minutes / 60) %> h</div>
          <div class="stat-label">Temps de service</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= totals.actions %></div>
          <div class="stat-label">Actions</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= h.formatMoney(totals.amount) %></div>
          <div class="stat-label">Chiffre genere</div>
        </div>
        <div class="card stat">
          <div class="stat-value"><%= activeMembers %></div>
          <div class="stat-label">Membres actifs</div>
        </div>
      </div>

      <div class="card" style="margin-bottom:22px">
        <h3>Temps de service par jour</h3>
        <div class="chart">
          <% series.forEach(function (d) { %>
            <div class="chart-bar" data-label="<%= h.formatDate(d.day, site.locale) %> · <%= h.formatDuration(d.minutes) %>">
              <span style="height:<%= Math.round((d.minutes / maxMin) * 100) %>%"></span>
            </div>
          <% }); %>
        </div>
        <div class="chart-axis">
          <span><%= h.formatDate(series[0] && series[0].day, site.locale) %></span>
          <span><%= h.formatDate(series[series.length - 1] && series[series.length - 1].day, site.locale) %></span>
        </div>
      </div>

      <div class="grid grid-2">
        <div class="card">
          <h3>Classement · temps de service</h3>
          <% if (!ranking.length) { %>
            <p class="muted" style="margin:0">Aucune donnee sur la periode.</p>
          <% } %>
          <% ranking.forEach(function (r) { %>
            <div class="bar-row">
              <span><%= r.name %></span>
              <span class="bar-track"><span class="bar-fill" style="width:<%= Math.round((r.minutes / maxRank) * 100) %>%"></span></span>
              <span class="num"><%= h.formatDuration(r.minutes) %></span>
            </div>
          <% }); %>
        </div>

        <div class="card">
          <h3>Repartition par grade</h3>
          <% if (!distribution.length) { %>
            <p class="muted" style="margin:0">Aucun effectif actif.</p>
          <% } %>
          <% distribution.forEach(function (d) { %>
            <div class="bar-row">
              <span><%= d.name %></span>
              <span class="bar-track"><span class="bar-fill" style="width:<%= Math.round((d.count / maxDist) * 100) %>%;background:<%= d.color %>"></span></span>
              <span class="num"><%= d.count %></span>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</div>
