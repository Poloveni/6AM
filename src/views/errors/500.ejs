<section class="section">
  <div class="wrap center" style="padding:80px 0">
    <p class="eyebrow">Erreur 500</p>
    <h1>Une erreur est survenue</h1>
    <p class="muted">Le probleme a ete enregistre dans les logs du serveur.</p>
    <a class="btn" href="/">Retour a l'accueil</a>
    <% if (locals.detail) { %>
      <pre style="text-align:left;overflow:auto;background:#0a1017;border:1px solid #1b2836;border-radius:10px;padding:16px;margin-top:26px;font-size:.78rem"><%= detail %></pre>
    <% } %>
  </div>
</section>
