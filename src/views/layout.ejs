<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= site.name %></title>
  <meta name="description" content="<%= currentPath.startsWith('/espace') ? site.description : '6AM : une famille de San Andreas aux racines britanniques. Loyauté, maîtrise et patience. Pendant qu’ils dorment, nous préparons demain.' %>">
  <meta property="og:title" content="<%= title %> · <%= site.name %>">
  <meta property="og:description" content="6AM — Pendant qu’ils dorment, nous préparons demain. Groupe fictif FiveM Roleplay.">
  <meta property="og:image" content="/static/img/og.jpg">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <% if (currentPath.startsWith('/espace') || currentPath.startsWith('/connexion')) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta name="theme-color" content="#101311">
  <link rel="icon" href="/static/img/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/static/img/logo.png">
  <link rel="stylesheet" href="/static/css/style.css?v=6am-2">
  <% if (!currentPath.startsWith('/espace')) { %><link rel="stylesheet" href="/static/css/vitrine.css?v=6am-2"><% } %>
  <% if (currentPath.startsWith('/espace')) { %><link rel="stylesheet" href="/static/css/espace.css?v=6am-4"><% } %>
  <%- style %>
  <link rel="stylesheet" href="/static/css/dawn.css?v=6am-1">
  <%# Filet de securite : sans JavaScript, les blocs a apparition restent visibles. %>
  <noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body class="<%= bodyClass %>">
  <% var nu = locals.plein === true; // page pleine : ni en-tete ni pied de page %>
  <% if (!nu) { %><%- include('partials/header') %><% } %>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <main id="contenu" tabindex="-1">
    <%- body %>
  </main>
  <% if (!nu) { %><%- include('partials/footer') %><% } %>
  <script src="/static/js/app.js?v=6am-3" defer></script>
  <% if (currentPath.startsWith('/espace')) { %><script src="/static/js/espace.js" defer></script><% } %>
  <%- script %>
</body>
</html>
