<% if (!dispo) { %>
  <div class="alert alert-info">
    <strong>Bot Discord non connecté.</strong>
    <% if (!diag.configure) { %>
      Renseigne <code>BOT_DATABASE_URL</code> dans le fichier <code>.env</code> du serveur, avec un utilisateur PostgreSQL en lecture seule, puis redémarre l’application.
    <% } else { %>
      La base du bot ne répond pas<%= diag.erreur ? ' (' + diag.erreur + ')' : '' %>. Les chiffres ci-dessous resteront vides tant qu’elle est injoignable.
    <% } %>
  </div>
<% } %>
