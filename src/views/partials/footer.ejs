<footer class="site-footer">
  <div class="wrap">
    <span>&copy; <%= new Date().getFullYear() %> <%= site.name %> — <%= site.tagline %></span>
    <span class="spacer"></span>
    <% if (links.discord) { %><a href="<%= links.discord %>" rel="noopener" target="_blank">Discord</a><% } %>
    <% if (links.youtube) { %><a href="<%= links.youtube %>" rel="noopener" target="_blank">YouTube</a><% } %>
    <% if (links.tiktok) { %><a href="<%= links.tiktok %>" rel="noopener" target="_blank">TikTok</a><% } %>
    <% if (links.twitter) { %><a href="<%= links.twitter %>" rel="noopener" target="_blank">X</a><% } %>
    <a href="/#code">Le code</a>
    <% if (user) { %>
      <form method="post" action="/deconnexion" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-ghost" type="submit">Deconnexion</button>
      </form>
    <% } %>
  </div>
</footer>
