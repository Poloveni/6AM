<%
  // Navigation de l'espace membres, groupee par domaine.
  // Le libelle de la synthese de l'organisation ne peut pas etre « Tableau de
  // bord » : ce nom est deja celui de l'espace personnel, et deux entrees
  // identiques menant a deux pages differentes sont illisibles.
  var estStaff = user && h.roleAtLeast(user.role, 'staff');
  var estAdmin = user && user.role === 'admin';

  var groupes = [
    { titre: 'Espace', liens: [
      ['/espace',                 'Tableau de bord', currentPath === '/espace'],
      ['/espace/effectifs',       'Effectifs',       currentPath.startsWith('/espace/effectifs')],
      ['/espace/activite',        'Activité',        currentPath.startsWith('/espace/activite')],
      ['/espace/statistiques',    'Statistiques',    currentPath.startsWith('/espace/statistiques')],
    ] },
    { titre: 'Organisation', liens: [
      ['/espace/organisation/ma-semaine', 'Ma semaine', currentPath === '/espace/organisation/ma-semaine'],
      ['/espace/organisation/armurerie',  'Armurerie',  currentPath === '/espace/organisation/armurerie'],
    ].concat(estStaff ? [
      ['/espace/organisation',            'Synthèse',   currentPath === '/espace/organisation'],
      ['/espace/organisation/taxes',      'Taxes',      currentPath === '/espace/organisation/taxes'],
      ['/espace/organisation/vehicules',  'Véhicules',  currentPath === '/espace/organisation/vehicules'],
    ] : []) },
  ];

  if (estAdmin) {
    groupes.push({ titre: 'Administration', liens: [
      ['/espace/administration',          'Comptes', currentPath === '/espace/administration'],
      ['/espace/administration/grades',   'Grades',  currentPath.startsWith('/espace/administration/grades')],
      ['/espace/administration/contenu',  'Contenu', currentPath.startsWith('/espace/administration/contenu')],
    ] });
  }

  groupes.push({ titre: 'Compte', liens: [
    ['/espace/mon-compte', user && user.rp_name ? user.rp_name : 'Mon compte', currentPath === '/espace/mon-compte'],
  ] });
%>
<nav class="side-nav" aria-label="Navigation de l’espace membres">
  <% groupes.forEach(function (g) { %>
    <div class="nav-groupe">
      <span class="group-label"><%= g.titre %></span>
      <div class="nav-liens">
        <% g.liens.forEach(function (l) { %>
          <a href="<%= l[0] %>" class="<%= l[2] ? 'is-active' : '' %>"<%= l[2] ? ' aria-current="page"' : '' %>><%= l[1] %></a>
        <% }); %>
      </div>
    </div>
  <% }); %>
</nav>
