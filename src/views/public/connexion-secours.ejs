<div class="auth-wrap">
  <div class="auth-card">
    <img class="brand-mark" src="/static/img/logo.png" alt="<%= site.name %>">
    <div class="card">
      <h1 style="font-size:1.5rem;text-align:center;margin-bottom:.2em">Connexion de secours</h1>
      <p class="muted center" style="font-size:.88rem;margin-bottom:1.6em">
        A utiliser quand Discord est indisponible.
      </p>

      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

      <form method="post" action="/connexion" autocomplete="on">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="identifier">Email ou identifiant</label>
          <input id="identifier" name="identifier" type="text" value="<%= identifier %>" required autofocus autocomplete="username">
        </div>
        <div class="field">
          <label for="password">Mot de passe</label>
          <input id="password" name="password" type="password" required autocomplete="current-password">
        </div>
        <button class="btn btn-primary btn-block" type="submit">Se connecter</button>
      </form>

      <p class="help center" style="margin-top:16px">
        <a href="/connexion">Revenir a la connexion Discord</a>
      </p>
    </div>
  </div>
</div>
