<style>
  .auth-discord {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    width: 100%; padding: 15px 22px; margin-top: 6px;
    background: #5865F2; border: 1px solid #6b77f5; color: #fff;
    font-family: var(--sans); font-size: .95rem; font-weight: 500; letter-spacing: .04em;
    transition: background-color .25s ease, transform .25s ease, box-shadow .25s ease;
  }
  .auth-discord:hover {
    background: #6d78f5; color: #fff;
    transform: translateY(-2px); box-shadow: 0 14px 34px rgba(88,101,242,.32);
  }
  .auth-discord svg { width: 22px; height: 22px; flex: none; }

  .auth-note {
    margin: 22px 0 0; padding-top: 20px; border-top: 1px solid var(--line-soft);
    font-size: .82rem; line-height: 1.7; color: var(--muted); text-align: center;
  }
  .auth-erreur {
    margin: 0 0 18px; padding: 13px 16px;
    border: 1px solid rgba(182,86,74,.4); border-left-width: 2px;
    background: rgba(182,86,74,.10); color: #e7c6c1;
    font-size: .88rem; line-height: 1.6;
  }
  @media (prefers-reduced-motion: reduce) { .auth-discord { transition: none; } }
</style>

<%
  var messages = {
    serveur:      'Ce compte Discord ne fait pas partie du serveur de la 6AM. Rejoins-le, puis reessaie.',
    refus:        'Connexion annulee : l’autorisation a ete refusee sur Discord.',
    etat:         'La demande a expire. Relance la connexion depuis cette page.',
    desactive:    'Ce compte a ete desactive. Contacte un administrateur.',
    indisponible: 'La connexion par Discord n’est pas configuree sur ce site.',
    profil:       'Discord n’a pas renvoye de profil exploitable. Reessaie dans un instant.',
    technique:    'Discord n’a pas repondu correctement. Reessaie dans un instant.',
  };
%>

<div class="auth-wrap">
  <div class="auth-card">
    <img class="brand-mark" src="/static/img/logo.png" alt="<%= site.name %>">
    <div class="card">
      <h1 style="font-size:1.5rem;text-align:center;margin-bottom:.2em">Espace membres</h1>
      <p class="muted center" style="font-size:.88rem;margin-bottom:1.6em">
        Reserve aux membres de <%= site.name %>.
      </p>

      <% if (erreur && messages[erreur]) { %>
        <p class="auth-erreur"><%= messages[erreur] %></p>
      <% } else if (erreur) { %>
        <p class="auth-erreur">La connexion n’a pas abouti. Reessaie dans un instant.</p>
      <% } %>

      <% if (discordActif) { %>
        <a class="auth-discord" href="/connexion/discord">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.369A19.79 19.79 0 0 0 15.432 3c-.21.375-.455.88-.623 1.28a18.27 18.27 0 0 0-5.618 0A12.6 12.6 0 0 0 8.56 3a19.74 19.74 0 0 0-4.886 1.372C.533 9.046-.32 13.58.099 18.057A19.9 19.9 0 0 0 6.11 21a14.9 14.9 0 0 0 1.29-2.105 12.9 12.9 0 0 1-2.03-.978c.17-.126.337-.257.497-.392a14.2 14.2 0 0 0 12.264 0c.163.137.33.268.498.392-.647.383-1.33.71-2.035.98A14.7 14.7 0 0 0 17.886 21a19.85 19.85 0 0 0 6.014-2.943c.49-5.19-.838-9.684-3.583-13.688ZM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.42 0-1.332.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.156 2.42 0 1.334-.955 2.42-2.156 2.42Zm7.975 0c-1.183 0-2.157-1.086-2.157-2.42 0-1.332.955-2.42 2.157-2.42 1.21 0 2.176 1.096 2.156 2.42 0 1.334-.946 2.42-2.156 2.42Z"/>
          </svg>
          Se connecter avec Discord
        </a>
        <p class="auth-note">
          Il faut faire partie du serveur Discord de la 6AM.
          <% if (links.discord) { %>
            <br><a href="<%= links.discord %>" rel="noopener" target="_blank">Rejoindre le Discord</a>
          <% } %>
        </p>
      <% } else { %>
        <p class="auth-erreur" style="margin:0">
          La connexion par Discord n’est pas encore configuree.
          Un administrateur peut passer par <a href="/connexion/secours">la connexion de secours</a>.
        </p>
      <% } %>
    </div>
  </div>
</div>
