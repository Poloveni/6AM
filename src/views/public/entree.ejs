<style>
  html, body { height: 100%; overflow: hidden; }
  .entree {
    position: relative; min-height: 100vh; min-height: 100svh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 40px 24px;
    background: radial-gradient(ellipse at 50% 44%, #16283c 0%, #080e17 52%, #03060a 100%);
  }
  .entree__fx { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
  .entree__inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; }

  .entree__logo {
    width: min(400px, 66vw); height: auto; display: block;
    filter: drop-shadow(0 0 70px rgba(90, 140, 195, .38)) drop-shadow(0 22px 46px rgba(0,0,0,.85));
    animation: entreeFlotte 8s ease-in-out infinite, entreeApparait 1.6s cubic-bezier(.2,.8,.2,1) both;
  }
  .entree__eyebrow {
    margin: 34px 0 8px; font-size: .68rem; letter-spacing: .3em; text-transform: uppercase;
    color: #7e9bb6; animation: entreeApparait 1.6s .35s both;
  }
  .entree__titre {
    font-family: var(--serif); font-weight: 400; margin: 0;
    font-size: clamp(64px, 12vw, 132px); line-height: .95; letter-spacing: -.04em;
    background: linear-gradient(180deg, #f4f9ff 8%, #a8c2dc 58%, #4a6a8f 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: entreeApparait 1.6s .5s both;
  }
  .entree__titre span { color: #7c9bb6; -webkit-text-fill-color: #7c9bb6; }
  .entree__devise {
    font-family: var(--serif); font-style: italic; color: #c3d3e2;
    font-size: clamp(15px, 2vw, 20px); margin: 20px 0 6px;
    animation: entreeApparait 1.6s .7s both;
  }
  .entree__sous {
    font-size: .68rem; letter-spacing: .3em; text-transform: uppercase; color: #6f89a2;
    margin: 0 0 40px; animation: entreeApparait 1.6s .8s both;
  }
  .entree__btn {
    display: inline-flex; align-items: center; gap: 26px;
    background: #b8cbdc; border: 1px solid #d3e1ed; color: #101b26;
    padding: 17px 34px; font-size: 12px; letter-spacing: .28em;
    transition: background .25s, transform .25s, box-shadow .25s;
    animation: entreeApparait 1.6s .95s both;
  }
  .entree__btn:hover { background: #e6f1fb; color: #101b26; transform: translateY(-2px); box-shadow: 0 14px 40px rgba(90,140,195,.28); }
  .entree__btn span { font-size: 20px; }

  .entree__pied {
    position: absolute; bottom: 24px; left: 0; right: 0; z-index: 2;
    font-size: .62rem; letter-spacing: .26em; text-transform: uppercase; color: #5d738a; animation: entreeApparait 1.6s 1.2s both;
  }
  .entree__pied a { color: #7e9bb6; }
  .entree__pied a:hover { color: var(--silver); }

  .entree.part { animation: entreeSort .65s ease forwards; }

  @keyframes entreeApparait { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes entreeFlotte { 50% { transform: translateY(-13px); } }
  @keyframes entreeSort { to { opacity: 0; transform: scale(1.05); } }

  @media (max-height: 860px) { .entree__logo { width: min(290px, 48vw); } .entree__eyebrow { margin-top: 22px; } .entree__sous { margin-bottom: 28px; } }
  @media (max-height: 700px) { .entree__logo { width: min(215px, 40vw); } .entree__titre { font-size: clamp(48px, 9vw, 76px); } }
  @media (prefers-reduced-motion: reduce) {
    .entree__logo, .entree__eyebrow, .entree__titre, .entree__devise, .entree__sous, .entree__btn, .entree__pied { animation: none; }
    .entree.part { animation: none; opacity: 0; }
  }
</style>

<main class="entree" id="entree">
  <canvas class="entree__fx" id="entree-fx" aria-hidden="true"></canvas>

  <div class="entree__inner">
    <img class="entree__logo" src="/static/img/logo.png" alt="Emblème de la 6AM" width="400" height="400">
    <p class="entree__eyebrow">Los Santos · <%= site.tagline %></p>
    <h1 class="entree__titre"><%= site.name %><span>.</span></h1>
    <p class="entree__devise">« Pendant qu’ils dorment, nous préparons demain. »</p>
    <p class="entree__sous">Loyauté · Respect · Patience</p>
    <a class="entree__btn" href="/accueil" id="entree-btn">ENTRER <span aria-hidden="true">↗</span></a>
  </div>

  <p class="entree__pied">
    <a href="/espace">Espace membres</a> · Groupe fictif · FiveM Roleplay
  </p>
</main>

<script src="/static/js/entree.js" defer></script>
