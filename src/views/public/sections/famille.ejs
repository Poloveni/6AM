<section class="v-section reveal" id="famille">
  <div class="v-heading">
    <p class="v-kicker">03 / LA FAMILLE &nbsp;·&nbsp; <%= members.length %> MEMBRE<%= members.length > 1 ? 'S' : '' %></p>
    <h2>Des parcours différents.<br><em>Une même heure.</em></h2>
    <p>Londres, Los Santos, Dallas, Birmingham, Manchester, Miami. Chacun est arrivé par un chemin qui lui est propre. Ce qui les réunit tient en trois mots : loyauté, respect, patience.</p>
  </div>

  <% if (!members.length) { %>
    <p class="v-note">Les effectifs seront publiés prochainement.</p>
  <% } else { %>
    <div class="v-values v-roster">
      <% members.forEach(function (m) { %>
        <article>
          <span>
            <% if (m.rank_name) { %><strong style="color:<%= m.rank_color %>;font-weight:400"><%= m.rank_name.toUpperCase() %></strong> ·<% } %>
            <%= (m.origin || 'Los Santos').toUpperCase() %>
          </span>
          <h3><%= m.rp_name %></h3>
          <% if (m.bio) { %><p><%= m.bio %></p><% } %>
        </article>
      <% }); %>
    </div>
  <% } %>

  <figure class="v-wide v-contained reveal">
    <img src="/static/img/vitrine/rencontre.webp" width="810" height="510" loading="lazy" alt="Une rencontre entre membres de la 6AM">
    <figcaption>LA CONFIANCE SE CONSTRUIT SUR LE TERRAIN.</figcaption>
  </figure>
</section>
