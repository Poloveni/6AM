<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Presentation</p>
      <h1>Le serveur <%= site.name %></h1>
      <p class="muted" style="white-space:pre-line"><%= settings.about_text || site.description %></p>
    </div>

    <div class="grid grid-3">
      <div class="card card-hover">
        <h3>Economie equilibree</h3>
        <p class="muted" style="margin:0">Des metiers legaux rentables, une progression lente et lisible, pas de course a l'argent.</p>
      </div>
      <div class="card card-hover">
        <h3>Factions &amp; entreprises</h3>
        <p class="muted" style="margin:0">Chaque structure dispose de ses effectifs, de ses grades et de son suivi d'activite.</p>
      </div>
      <div class="card card-hover">
        <h3>Scenes encadrees</h3>
        <p class="muted" style="margin:0">Braquages, enquetes, evenements de ville : le staff pose le cadre, les joueurs ecrivent la suite.</p>
      </div>
      <div class="card card-hover">
        <h3>Whitelist</h3>
        <p class="muted" style="margin:0">Entree sur entretien pour garantir un niveau de RP homogene.</p>
      </div>
      <div class="card card-hover">
        <h3>Serveur optimise</h3>
        <p class="muted" style="margin:0">Ressources maison, framework maitrise, mises a jour regulieres.</p>
      </div>
      <div class="card card-hover">
        <h3>Evenements</h3>
        <p class="muted" style="margin:0">Rendez-vous hebdomadaires, courses, soirees et arcs narratifs de ville.</p>
      </div>
    </div>
  </div>
</section>
